# OpenAI / LLM Configuration
# Required: The key for GPT-4 or DeepSeek
OPENAI_API_KEY=sk-proj-...
# OR
LLM_API_KEY=sk-...

# Optional: If using a custom endpoint (e.g. DeepSeek or a proxy)
# LLM_BASE_URL=https://api.deepseek.com/v1

# Optional: Model selection (defaults to gpt-4o)
LLM_MODEL=gpt-4o

# LangSmith Tracing (Optional but recommended for LangGraph)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
